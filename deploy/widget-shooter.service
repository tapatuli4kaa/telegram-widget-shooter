[Unit]
Description=Telegram widget shooter bot
After=network-online.target
Wants=network-online.target

[Service]
User=widgetbot
WorkingDirectory=/opt/telegram-widget-shooter
ExecStart=/usr/bin/node bot.mjs
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
